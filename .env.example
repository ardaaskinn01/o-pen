# ==============================================================================
# O-PEN RESEND E-POSTA YAPILANDIRMASI
# (Vercel Environment Variables veya yerel .env dosyasına eklenecekler)
# ==============================================================================

# 1. Resend API Anahtarı (Resend.com > API Keys ekranından alınır)
RESEND_API_KEY=re_123456789_abcdefg

# 2. Gönderen E-Posta Başlığı (Domain doğrulandıktan sonra)
FROM_EMAIL="O-PEN İletişim <info@o-pen.com>"

# 3. Form Bildirimlerinin Düşeceği Adres (Sizin kişisel veya Cloudflare yönlendirmeli adresiniz)
MAIL_TO=info@o-pen.com
